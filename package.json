{
  "private": true,
  "name": "wuxia-spire",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run test:types && npm run lint && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "sim": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/server/simCli.ts",
    "sim:10": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/server/simCli.ts --runs 10",
    "sim:20": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/server/simCli.ts --runs 20",
    "sim:50": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/server/simCli.ts --runs 50",
    "sim:overnight": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/server/simCli.ts --runs 50 --batches 4",
    "test:types": "tsc --build",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-gothic": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@hono/node-server": "2.1.6",
    "@stylexjs/stylex": "^0.19.2",
    "devvit": "0.15.3",
    "hono": "4.13.17",
    "phaser": "4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  }
}
